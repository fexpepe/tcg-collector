# Cabeçalhos de segurança (lidos pelo Cloudflare Pages). HTTPS é automático.
#
# A CSP vive AQUI (não em <meta> por página): via header ela cobre também as
# páginas pré-renderizadas de set/carta, permite frame-ancestors (que <meta>
# ignora) e evita manter 30 cópias sincronizadas. É uma política única pro site
# inteiro — inclui blob: (export de binder) e challenges.cloudflare.com
# (Turnstile do login), inofensivos nas demais páginas.
#
# style-src mantém 'unsafe-inline' de propósito: o UI Editor e o print de
# binders injetam <style> dinâmicos (conteúdo do usuário — nonce/hash não
# se aplicam). Scripts continuam sem 'unsafe-inline', que é o que importa.
#
# IMPORTANTE: os hosts de imagem (tcgdex/tcgplayer-cdn/scryfall/lorcast/wsrv…)
# estão em img-src E em connect-src. O connect-src é obrigatório porque o
# service worker (sw.js) baixa TODA imagem via fetch(), que é regido por
# connect-src (não img-src). Sem eles no connect-src, o SW é bloqueado pela CSP
# e as imagens somem no site inteiro. (Quando a CSP vivia no <meta> isso não
# aparecia: meta-CSP não vale pro contexto do SW; via header, vale.)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://assets.tcgdex.net https://images.pokemontcg.io https://raw.githubusercontent.com https://tcgplayer-cdn.tcgplayer.com https://cards.lorcast.io https://cards.scryfall.io https://svgs.scryfall.io https://wsrv.nl; connect-src 'self' https://api.tcgdex.net https://assets.tcgdex.net https://images.pokemontcg.io https://raw.githubusercontent.com https://tcgplayer-cdn.tcgplayer.com https://cards.lorcast.io https://cards.scryfall.io https://svgs.scryfall.io https://wsrv.nl https://pokeapi.co https://economia.awesomeapi.com.br https://dlnalopazitfdgnmdguu.supabase.co https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# App shell (src/*.js e styles.css). Estes valores são os do REPOSITÓRIO, onde
# os arquivos não têm versão na URL: revalidar sempre é o que evita ficar preso
# numa versão antiga depois de um deploy.
#
# No DEPLOY o scripts/hash-assets.mjs põe o hash do conteúdo no nome
# (src/shared.<hash>.js) e troca estas duas linhas por um ano de `immutable` —
# com a URL mudando a cada versão, revalidar deixa de ser necessário e as ~6
# requisições condicionais por navegação somem. Se algum dia o passo de hash sair
# do build, estes valores precisam VOLTAR ao no-cache.
/src/*
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache

# Fonte da marca: conteúdo imutável (o .woff2 do Outfit v15 não muda). Cache
# longo evita re-baixar 31KB a cada visita. Ao trocar a fonte, RENOMEIE o
# arquivo (outfit-v16-…) em vez de sobrescrever — com immutable, o navegador
# não revalida e ficaria com a versão velha por um ano.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Catálogo (data/*): sem regra, caía no default do Pages (max-age=0,
# must-revalidate) e toda revisita pagava uma requisição condicional por chunk —
# 648 no Magic, 200 no Pokémon EN. 1h fresco + 1 dia servindo stale enquanto
# revalida é seguro: o sync é união preservadora (carta não some) e o app shell
# (HTML/JS com hash) continua network-first, então só o dado atrasa até 1h.
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
