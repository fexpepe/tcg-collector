# Cache do sync da TCGdex (regenerável com node scripts/sync-tcgdex.mjs)
data/.cache/

# Artefatos gerados pelo sync (regeneráveis; o app usa data/cards.js por padrão).
# O padrão data/*/ cobre TODOS os jogos — antes só lorcana/onepiece estavam
# listados e os .generated de naruto/hxh/jump ficaram trackeados por engano,
# gerando um commit de snapshot por build (o generatedAt muda sempre).
data/*.generated.js
data/*.generated.json
data/*/*.generated.js
data/*/*.generated.json
# data/sets/ (chunks do Pokémon) é VERSIONADO de propósito: o deploy commita o
# snapshot validado de volta (carta indexada nunca some, mesmo se a TCGdex sumir).
# Chunks por set dos outros jogos (gerados por writeGameCatalog no build)
data/*/sets/
# Magic segue o padrão POKÉMON: chunks versionados (delta pequeno por set no
# git), e o cards.js monolítico (~30MB, mudaria toda semana = blob novo gigante)
# fica de fora — é regenerado dos chunks no build (sync-magic.mjs --no-fetch).
!data/magic/sets/
data/magic/cards.js
data/magic/indexes.js
data/magic/pricing.js
# Fatias do índice (indexes-sets.json etc.): mesma regra do indexes.js acima. As
# do Magic sozinhas dão 2,8 MB (sets 1,4 + artists 1,4) e são 100% derivadas —
# o build as regenera via writeSplitIndexes/split-indexes.mjs.
data/magic/indexes-*.json

# Yu-Gi-Oh! segue o mesmo padrão do Magic: ~46k impressões, cards.js monolítico
# de dezenas de MB (estoura o limite de 25 MiB/arquivo do Cloudflare Pages) fica
# de fora; os chunks por set são versionados e o build regenera o resto.
!data/ygo/sets/
data/ygo/cards.js
data/ygo/indexes.js
data/ygo/pricing.js
data/ygo/indexes-*.json

# Índice de busca do construtor de decks (writeGameCatalog gera no build a partir
# do catálogo). Derivado 100% dos chunks — versionar seria duplicar o catálogo no
# git e gerar blob novo a cada sync (o do Magic sozinho passa de 5 MB).
data/search-index.json
data/*/search-index.json

# Páginas de set pré-renderizadas p/ SEO (geradas no build por scripts/prerender-catalog.mjs)
set/
card/

# Key local da PokemonPriceTracker (só pra teste local; NUNCA versionar)
.ppt.key
# Chaves do web push (privada VAPID + chave do sender; vão pra GitHub Secrets)
.vapid.key
.push.key
# Saídas temporárias dos probes/dry-runs da PPT
ppt-*.txt

# Configuração local do Claude Code
.claude/settings.local.json

# Dependências e cache de ferramentas (nunca versionar; apareceram de npx/wrangler
# locais — o site é estático e não tem package.json na raiz)
node_modules/
.wrangler/

# Lixo de SO/editor
Thumbs.db
.DS_Store

# MCP local (config de ferramenta, nao versionar)
.mcp.json
